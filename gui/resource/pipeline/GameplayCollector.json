{
    "CollectorEntry": {
        "next": [
            "__CollectorReady",
            "[JumpBack]FinishGameGoBack",
            "[JumpBack]EnterGameEntrance",
            "[JumpBack]TerminalAnyEnter"
        ]
    },
    "__CollectorReady": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "StartGameFromGameEntrance"
                ]
            }
        },
        "next": [
            "[JumpBack]StartGameFromGameEntrance",
            "[JumpBack]__CollectorLoop"
        ],
        "on_error": [
            "CollectorEntry"
        ]
    },
    "__CollectorLoop": {
        "timeout": 180000,
        "rate_limit": 250,
        "next": [
            "[JumpBack]IsRoundReady1",
            "[JumpBack]IsRoundReady2",
            "[JumpBack]IsLeftWin",
            "[JumpBack]IsRightWin",
            "[JumpBack]IsRankingGenerated",
            "FinishGameGoBack"
        ],
        "on_error": [
            "CollectorEntry"
        ]
    }
}
