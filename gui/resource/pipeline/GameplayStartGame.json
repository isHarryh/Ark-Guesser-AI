{
    "StartGameFromGameEntrance": {
        "desc": "从玩法入口（或匹配页面）开始游戏，失败则尝试TerminalAnyEnter",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__EnterMatchMode3",
                    "__EnterGameMode2",
                    "__WaitGameStartLoading"
                ]
            }
        },
        "timeout": 60000,
        "rate_limit": 1000,
        "next": [
            "[JumpBack]__EnterMatchMode3",
            "[JumpBack]__EnterGameMode2",
            "__WaitGameStartLoading"
        ],
        "on_error": [
            "[JumpBack]TerminalAnyEnter",
            "StartGameFromGameEntrance"
        ]
    },
    "__EnterMatchMode3": {
        "desc": "在玩法入口点击匹配模式3（联机匹配模式）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Gameplay/ChooseMatchMode3.png"
                ],
                "roi": [
                    1655,
                    796,
                    240,
                    251
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 1000
    },
    "__EnterGameMode2": {
        "desc": "在匹配页面点击玩法模式2（礼物竞猜模式）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Gameplay/ChooseGameMode2.png"
                ],
                "roi": [
                    736,
                    840,
                    303,
                    176
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "__ConfirmGameStart"
        ]
    },
    "__ConfirmGameStart": {
        "desc": "在匹配页面点击开始按钮",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Gameplay/ConfirmGameStart1.png"
                ],
                "roi": [
                    1693,
                    655,
                    192,
                    306
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "__WaitGameStartLoading": {
        "desc": "等待加载画面出现",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Gameplay/GameStartLoading.png"
                ],
                "roi": [
                    677,
                    231,
                    565,
                    584
                ]
            }
        },
        "timeout": 60000,
        "rate_limit": 2000,
        "next": [
            "__WaitGameStopLoading"
        ]
    },
    "__WaitGameStopLoading": {
        "desc": "等待加载画面消失",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__WaitGameStartLoading"
                ]
            }
        },
        "inverse": true
    }
}
